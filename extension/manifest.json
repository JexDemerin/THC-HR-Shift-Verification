{
  "manifest_version": 3,
  "name": "THC WellSky Shift Scanner",
  "version": "0.2.0",
  "description": "Scans the visible WellSky schedule for incomplete shifts and sends them to a Google Sheet for payroll follow-up.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
